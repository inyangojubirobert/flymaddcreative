{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/websiteapp",
      "destination": "/websiteapp"
    },
    {
      "source": "/Onedream",
      "destination": "/websiteapp"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/admin/ads/sync-voided",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/admin/ads/recheck-links",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/admin/digital/sync-voided",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/admin/digital/billing-sync",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/admin/gifts/sync-voided",
      "schedule": "50 3 * * *"
    },
    {
      "path": "/api/admin/earnings/jobs",
      "schedule": "55 3 * * *"
    },
    {
      "path": "/api/admin/currency",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/admin/earnings/complete-unreturned",
      "schedule": "50 3 * * *"
    }
  ]
}
